params {
    max_memory = 16.GB
    max_cpus   = 4
    max_time   = 12.h
}

process {
    executor      = 'awsbatch'
    errorStrategy = { task.exitStatus in ((130..145) + 104 + 255) ? 'retry' : 'finish' }
    maxRetries    = 2

    resourceLimits = [ cpus: params.max_cpus, memory: params.max_memory, time: params.max_time ]

    // Starting values, not yet tuned on a large registry.
    withName: 'MERGE_SKETCHES' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
    }
}

aws {
    region = 'us-east-1'
}

docker {
    enabled = true
}
