params {
    max_memory = 128.GB
    max_cpus   = 16
    max_time   = 48.h
}

process {
    executor      = 'awsbatch'
    errorStrategy = { task.exitStatus in ((130..145) + 104 + 255) ? 'retry' : 'finish' }
    maxRetries    = 2

    resourceLimits = [ cpus: params.max_cpus, memory: params.max_memory, time: params.max_time ]

    // Starting values, not yet tuned on real data. Memory grows on retry
    // (exit 137 is an OOM kill, 255 is how AWS Batch reports one).
    withName: 'SAMTOOLS_INDEX' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
    }
    withName: 'SOMALIER_EXTRACT' {
        cpus   = 2
        memory = { 4.GB * task.attempt }
    }
    withName: 'SOMALIER_RELATE' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
    }
    withName: 'SOMALIER_CONTAMINATION' {
        cpus   = 4
        memory = { 16.GB * task.attempt }
    }
    withName: 'CONCORDANCE_REPORT' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
    }
}

aws {
    region = 'us-east-1'
}

docker {
    enabled = true
}
